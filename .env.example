# Konfigurim për zhvillim lokal. Kopjoje si `.env` dhe përshtate.
#
# KUJDES: në prodhim këto NUK lexohen nga ky skedar — Vite i pjek në build-time,
# ndaj imazhi i Docker-it i merr si --build-arg (shih etermini-deploy/.env).

# URL-ja bazë e API-së, me prapashtesën /api
VITE_API_URL=https://localhost:44305/api

# URL-ja bazë e hub-it SignalR (pa /api). Nëse lihet bosh, nxirret nga VITE_API_URL.
VITE_HUB_URL=https://localhost:44305

# --- Vlerat e prodhimit (referencë) ---
# VITE_API_URL=https://eterminiapi.troni.dev/api
# VITE_HUB_URL=https://eterminiapi.troni.dev
